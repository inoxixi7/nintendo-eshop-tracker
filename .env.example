# INSECURE PLACEHOLDER: copy to .env, replace the password, then chmod 0600 .env.
# POSTGRES_PASSWORD must be a high-entropy URL-safe value (letters, digits, - or _).
POSTGRES_DB=nintendo_eshop
POSTGRES_USER=eshop_tracker
POSTGRES_PASSWORD=change-me

DATA_DIR=../data/postgres
BACKUP_DIR=../backups
BACKUP_UID=1000
BACKUP_GID=1000

CATALOG_CRON=0 3 * * *
PRICE_CRON=0 */6 * * *
TZ=Asia/Tokyo
RUN_ON_STARTUP=true
BACKUP_INTERVAL_SECONDS=86400
BACKUP_MAX_AGE_SECONDS=172800

# API listens on 127.0.0.1 only; expose it with `tailscale serve`.
API_PORT=8194
