{
  "name": "@eshop-tracker/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R migrations dist",
    "test": "npm run test:source && npm run test:built",
    "test:source": "vitest run test/migrations.test.ts test/tracker-repository.test.ts",
    "test:built": "npm run build && vitest run test/migrations-built.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@eshop-tracker/shared": "workspace:*",
    "pg": "8.16.3"
  }
}
